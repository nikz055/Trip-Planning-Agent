# Copy to .env and fill in. Placeholders only: never commit real values.

# --- Supabase (Phase 2 onwards) -------------------------------------------
# Postgres connection string. Use the "Session pooler" string from the
# dashboard's Connect panel (port 5432); it works on IPv4 networks. The direct
# string (db.<project-ref>.supabase.co) needs IPv6. URL-encode any special
# characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres

# Project URL and public key. Used only by the test that checks the public key
# can read nothing. Either name works for the key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# --- LLM: leave unset to use the stand-in planner ------------------------
# An OpenAI-compatible endpoint with tool calling (OpenRouter by default)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<openrouter-api-key>
LLM_MODEL=<model-id>

# --- Optional overrides (defaults shown) ----------------------------------
# TRIP_AGENT_LLM_PROVIDER=auto        # auto | openrouter | standin
# TRIP_AGENT_MAX_ITERATIONS=8
# TRIP_AGENT_TOKEN_BUDGET=400000
# TRIP_AGENT_WALL_CLOCK_S=120
# TRIP_AGENT_COST_CAP_USD=2.0
# TRIP_AGENT_FRESHNESS_MINUTES=60
